{
  "name": "@uug-ai/odee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src tests tools '*.ts' '*.json' index.html",
    "format:check": "prettier --check src tests tools '*.ts' '*.json' index.html",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:oauth": "cd .. && ODEE_TEST_BROWSER=true GOWORK=off go test ./internal/accounting -run '^TestGitHubBrowserOAuth$' -count=1",
    "test:mongo": "node tests/mongo.mjs",
    "test:scans": "node tests/scans.mjs"
  },
  "dependencies": {
    "iconoir-react": "^7.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
