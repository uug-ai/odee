ODEE_ADDR=127.0.0.1:8098
ODEE_ORIGIN=http://localhost:8098
ODEE_COMPANY_NAME=My company
ODEE_COMPANY_ID=000000000000000000000001
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE_ODEE=odee
# Register ODEE_ORIGIN/auth/github/callback on the GitHub OAuth app.
ODEE_AUTH_MODE=github
# Authorization defaults to existing authenticated read/write/post, never admin.
# Apply reviewed grants by restart; shared/live grants and enforced rollout need human approval.
ODEE_AUTHZ_MODE=compatibility
# Explicit grants REPLACE compatibility rights. Empty capability arrays grant no actions.
# JSON array: [{"principal":"github:<positive numeric ID>","companyId":"<BSON ObjectID hex>","capabilities":["read"]}]
# Other stable server principals: token:company and development:local (shared/non-human).
ODEE_CAPABILITY_GRANTS=[]
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=uug-ai
GITHUB_TEAM=engineering
# Generate a separate, persistent Odee key: openssl rand -hex 32
SESSION_SECRET=
ODEE_DEV_MODE=false
ODEE_DEMO=false
# Legacy access-token mode: ODEE_AUTH_MODE=token and ODEE_API_TOKEN (32+ chars).
# Unauthenticated local testing only: ODEE_AUTH_MODE=token, ODEE_DEV_MODE=true.
# Local Poppler + Tesseract scanning; install the corresponding language packs.
ODEE_OCR_LANGUAGES=eng+nld+fra
